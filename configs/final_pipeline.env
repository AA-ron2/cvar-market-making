# Frozen production configuration for scripts/pipeline/submit_final_pipeline.sh
# Usage on Snellius:   source configs/final_pipeline.env && PIPELINE_STAGE=profile|final bash scripts/pipeline/submit_final_pipeline.sh
# The submit script sources this file itself and stops if the environment disagrees with any value.
# Changing any value below, except the runtime block's time limits, is a methodology change: add an entry to
# docs/design_decisions.md first. Between the profile and the final stage only B3_LAMBDA_LR and the time limits
# (*_TIME) may change: the final stage refuses any other difference from the profile stage's commit (D-19).

# --- Execution-intensity and volatility calibration (F-03) ---
export CALIBRATION_PROXY=best_price_reach
export CALIBRATION_START_RULE=fixed_stride
export CALIBRATION_DEPTH_TICKS="1 2 3 4 5 6 8 10 12 15 20"
export CALIBRATION_CENSOR_SECONDS=15
export CALIBRATION_START_STRIDE_SECONDS=15
export CALIBRATION_MIN_HITS=10
export CALIBRATION_VOL_WINDOW_SECONDS=600
# Expected Jan 1-6 output (check results/formula_train_params.json after the prepare job):
#   sigma=2.7568397609849377e-05  A=0.10877437260020707  kappa=12066.410319238006

# --- Action space shared by B0 tuning and B1-B3 (F-04) ---
export FORMULA_GAMMA_MIN=0.01
export FORMULA_GAMMA_MAX=0.9
export FORMULA_SKEW_TICKS_MAX=5
export FEATURE_WINDOW=100

# --- Evaluation (F-07) ---
export EVALUATION_FILL_SEEDS="42 43"
export EVALUATION_ROLLOUTS=20
export FIXED_CLOCK_SECONDS=60
export TRAINING_SEED=42

# --- B1 and B1_cand budget (F-16): exactly one pass over the phase's days; TOTAL_TIMESTEPS is refused ---
export B1_PASSES=1

# --- Exploration noise of every PPO policy (D-21): sigma0 in [-1, 1] action units, fixed (not learned) in B1, B1_cand and NB6; B2, B3 and B1+ inherit it (D-15b) ---
export POLICY_STD=0.3

# --- B2 candidates (F-05) ---
export B2_ALPHAS="0.1 1.0 10.0"

# --- Fill paths per training day for B2 (all phases), B3 and B1+, the same for all (D-12, D-18); lower only if memory forces it ---
export TRAINING_FILL_PATHS=16

# --- B3 threshold d (F-06, D-17): stochastic B1 rollouts per fill seed on Jan 1-6, read by the profile stage ---
export CVAR_ROLLOUTS_PER_SEED=20

# --- Risk-aware PPO iterations k for B2 (all phases), B3 and B1+ (D-11, D-18), fixed a priori (D-19) ---
export B2_UPDATES=10
export B3_UPDATES=10

# --- PPO learning rate of every fine-tune (D-23): B2 (all phases), B3 through the eta profiler, and B1+; B1, B1_cand and NB6 keep 3e-4 ---
export FINE_TUNE_LR=0.003

# --- Runtime, not methodology (D-19): Slurm wall-clock limits, HH:MM:SS (hours may exceed 24) ---
# The submit script requires each one and exits 2 if it is missing, malformed or zero (the author's values,
# 2026-10-08). B1_TIME: the final B1; B1_CAND_TIME: B1_cand; CVAR_CAL_TIME: the d calibration (two passes
# of B1 over Jan 1-6, D-17); DUAL_PROFILE_TIME: one eta per profiling array task (10 B3 updates);
# RISK_TRAIN_TIME: every B2 job and B1+ (k = 10 updates each); ABLATION_TIME: each NB6 job (one pass over
# Jan 1-4, like B1_cand, then Jan 5-6); B0_TIME: B0 (gamma tuning on Jan 1-6, then Jan 7-29); SHAP_TIME: SHAP.
export B1_TIME=24:00:00
export B1_CAND_TIME=24:00:00
export CVAR_CAL_TIME=48:00:00
export DUAL_PROFILE_TIME=72:00:00
export RISK_TRAIN_TIME=72:00:00
export ABLATION_TIME=24:00:00
export B0_TIME=24:00:00
export SHAP_TIME=08:00:00
# EVAL_TIME: every evaluate_formula_model.py job (B2 validation in the profile stage, the four test-day arrays in the final stage).
export EVAL_TIME=08:00:00

# --- Set after PIPELINE_STAGE=profile at fe5f9fe: the author's sign-off of 2026-10-15 on the D-12a choice (D-20, D-24) ---
export B3_LAMBDA_LR=8.0
